  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GeraldController
  wildBerry: {fileID: 11400000, guid: a94b44ba66d335d40962db8cdd280ad2, type: 2}
  berriesRequired: 3
  coinReward: 25
  berryQuest: {fileID: 1034972484}
  state: 0
  idleSouth: {fileID: 21300000, guid: 229a32b88c546044783274b6376411d7, type: 3}
  idleSouthEast: {fileID: 21300000, guid: 1ffc6f2c46e31af44ad71fe30b5897a1, type: 3}
  idleEast: {fileID: 21300000, guid: e21d1317d233b7540b2ab8b28378bc51, type: 3}
  idleNorthEast: {fileID: 21300000, guid: dda8f0faa40352240b7d9277f0a33562, type: 3}
  idleNorth: {fileID: 21300000, guid: 47917d57c60ae5648952c25dacf64b47, type: 3}
  idleNorthWest: {fileID: 21300000, guid: d2cab705dc1291642954eb9f9e6be4c7, type: 3}
  idleWest: {fileID: 21300000, guid: 3acd0b5a698c21a4d8a10569f541b118, type: 3}
  idleSouthWest: {fileID: 21300000, guid: a0232d3aead2a074eb1808e83c87a041, type: 3}
  idleFacing: 0
  introLines:
  - speakerName: Gerald
    text: Easy now, kit. These old whiskers have seen more sunrises than you've had
      naps.
  - speakerName: Gerald
    text: "Name's Gerald. I keep an eye on this stretch of yard \u2014 and on cats
      who rush about without looking."
  - speakerName: Gerald
    text: Tell you what. Bring me three Wild Berries from the forage patches. Sweet
      ones. Not the half-chewed kind you leave under the porch.
  - speakerName: Gerald
    text: Do that, and I'll see you sorted with a few CatCoins for your trouble.
      Fair pawshake?
  notEnoughLines:
  - speakerName: Gerald
    text: "Still short, kit \u2014 {have} of {need} Wild Berries. The bushes are
      out there. Sniff carefully."
  turnInLines:
  - speakerName: Gerald
    text: "Ah. There they are \u2014 sticky, bright, and honest. You've done right
      by an old tom."
  - speakerName: Gerald
    text: Take these CatCoins. Don't spend them all on catnip in one afternoon, hear
      me?
  completeLines:
  - speakerName: Gerald
    text: Still here, eh? Good. The yard's quieter with a friend who keeps their
      word.
  - speakerName: Gerald
    text: Go stretch those legs. I'll be on this spot if you need an old ear to bend.
